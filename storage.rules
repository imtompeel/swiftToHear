rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Demo videos of the practice/rounds — public read for church + open flows
    match /practiceVideos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default (configure authenticated uploads separately)
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
