# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Video: mesh (default WebRTC) or daily (SFU)
VITE_VIDEO_PROVIDER=mesh
# When using daily — point at your token server (see server/server.js)
# VITE_DAILY_TOKEN_URL=http://localhost:3001/api/daily/token

# TURN (strongly recommended for production mesh video)
# Option A — Metered / Open Relay API key:
# VITE_METERED_TURN_API_KEY=
# VITE_METERED_TURN_ENDPOINT=https://openrelay.metered.ca/openrelayproject
# Option B — static TURN:
# VITE_TURN_URLS=turn:your-turn.example:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
