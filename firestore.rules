rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: sessions
// Document ID: sessionId
// Fields:
//   - sessionId: string (required, immutable) - matches document ID
//   - sessionName: string (required, immutable)
//   - duration: number (required, immutable)
//   - topic: string (required; may be updated when selecting from suggestions)
//   - hostId: string (required, immutable) - Firebase Auth uid of host
//   - hostName: string (required, immutable)
//   - hostRole: string (optional, immutable)
//   - createdAt: timestamp (required, immutable)
//   - participants: list (required) - joiners may update (client-generated ids today)
//   - status: 'waiting' | 'active' | 'completed' (required) - host-only on update
//   - minParticipants / maxParticipants: number (required, immutable)
//   - topicSuggestions: list (required) - joiners may update
//   - sessionType: string (optional, immutable)
//   - currentPhase / phaseStartTime / currentRound / fivePersonChoice - host-only
//   - groupConfiguration: map (optional, immutable)
//   - scribeNotes / safetyTimeout - joiners may update
//   - accumulatedScribeNotes - host-only (rotation path)
//
// Collection: groupSessions
// Document ID: sessionId
// Similar shape plus groups / groupMode / groupConfiguration
// Updates require authentication.
//
// Collection: signaling
// Document ID: auto-id
// Fields:
//   - type: 'offer' | 'answer' | 'ice-candidate' | 'join' | 'leave'
//   - from: string (auth uid of sender)
//   - to: string (optional; required for offer/answer/ice-candidate)
//   - sessionId: string (WebRTC room id; may differ from the Firestore session id)
//   - baseSessionId: string (sessions/groupSessions document id used for ACL)
//   - data: map, timestamp, expiresAt
// Authenticated session members (hostId or participantIds) may create messages
// and listen to the session's signalling stream. Recipient filtering is client-side.
//
// Collection: matchRooms
// Document ID: roomId
// Fields:
//   - roomId, mode ('curious'|'full'), audience ('church'|'open'|'christadelphian')
//   - status ('filling'|'matched'|'expired')
//   - targetSize (3), participants[], participantIds[]
//   - createdAt, lastHeartbeatAt, matchedSessionId?
// Authenticated users may join/leave filling rooms; the joiner who fills
// the room may create an active matched session (matchMode set).
// Matching is scoped by mode + audience (funnel pool).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    function isSessionHost() {
      return isAuthenticated() && request.auth.uid == resource.data.hostId;
    }

    function sessionIdentityUnchanged() {
      return request.resource.data.hostId == resource.data.hostId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.hostName == resource.data.hostName &&
        request.resource.data.sessionName == resource.data.sessionName &&
        request.resource.data.duration == resource.data.duration &&
        request.resource.data.minParticipants == resource.data.minParticipants &&
        request.resource.data.maxParticipants == resource.data.maxParticipants;
    }

    function isValidTopicUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['topic']) ||
        (request.resource.data.topic is string &&
          request.resource.data.topic.size() > 0 &&
          request.resource.data.topic.size() <= 500);
    }

    function sessionOptionalIdentityUnchanged() {
      return (!('sessionType' in resource.data) ||
          request.resource.data.sessionType == resource.data.sessionType) &&
        (!('hostRole' in resource.data) ||
          request.resource.data.hostRole == resource.data.hostRole) &&
        (!('groupConfiguration' in resource.data) ||
          request.resource.data.groupConfiguration == resource.data.groupConfiguration) &&
        (!('matchMode' in resource.data) ||
          request.resource.data.matchMode == resource.data.matchMode);
    }

    function isValidSessionStatus(status) {
      return status in ['waiting', 'active', 'completed'];
    }

    function isValidHostedSessionCreate(sessionId) {
      return request.resource.data.keys().hasAll([
          'sessionId', 'sessionName', 'duration', 'topic', 'hostId',
          'hostName', 'createdAt', 'participants', 'status',
          'minParticipants', 'maxParticipants', 'topicSuggestions'
        ]) &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        !('matchMode' in request.resource.data) &&
        request.resource.data.sessionName is string &&
        request.resource.data.sessionName.size() > 0 &&
        request.resource.data.sessionName.size() <= 200 &&
        request.resource.data.topic is string &&
        request.resource.data.topic.size() <= 500 &&
        request.resource.data.duration is number &&
        request.resource.data.duration > 0 &&
        request.resource.data.participants is list &&
        request.resource.data.topicSuggestions is list &&
        request.resource.data.minParticipants is number &&
        request.resource.data.maxParticipants is number;
    }

    // Matchmaking: third joiner creates an already-active 3-person session.
    // Creator must be a participant; host is the first participant (may differ).
    function isValidMatchSessionCreate(sessionId) {
      return request.resource.data.keys().hasAll([
          'sessionId', 'sessionName', 'duration', 'topic', 'hostId',
          'hostName', 'createdAt', 'participants', 'participantIds', 'status',
          'minParticipants', 'maxParticipants', 'topicSuggestions', 'matchMode'
        ]) &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.matchMode in ['curious', 'full'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.currentPhase == 'hello-checkin' &&
        request.resource.data.sessionType == 'video' &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 3 &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 3 &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.hostId in request.resource.data.participantIds &&
        request.resource.data.minParticipants == 3 &&
        request.resource.data.maxParticipants == 3 &&
        request.resource.data.duration is number &&
        request.resource.data.duration > 0 &&
        request.resource.data.topic is string &&
        request.resource.data.topic.size() <= 500;
    }

    function isValidSessionCreate(sessionId) {
      return isValidHostedSessionCreate(sessionId) || isValidMatchSessionCreate(sessionId);
    }

    // Joiner path: authenticated users may update collaboration fields only.
    // participantIds is kept in sync with participants for signalling ACL.
    // topic may be set when selecting from lobby suggestions / word cloud.
    function isSessionParticipantFieldUpdate() {
      return isAuthenticated() &&
        sessionIdentityUnchanged() &&
        sessionOptionalIdentityUnchanged() &&
        isValidTopicUpdate() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participants', 'participantIds', 'topicSuggestions', 'scribeNotes', 'safetyTimeout', 'topic']) &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() <= 50 &&
        request.resource.data.topicSuggestions is list &&
        request.resource.data.topicSuggestions.size() <= 100 &&
        request.resource.data.status == resource.data.status &&
        (!('currentPhase' in resource.data) ||
          request.resource.data.currentPhase == resource.data.currentPhase) &&
        (!('currentRound' in resource.data) ||
          request.resource.data.currentRound == resource.data.currentRound) &&
        (!('phaseStartTime' in resource.data) ||
          request.resource.data.phaseStartTime == resource.data.phaseStartTime) &&
        (!('fivePersonChoice' in resource.data) ||
          request.resource.data.fivePersonChoice == resource.data.fivePersonChoice) &&
        (!('accumulatedScribeNotes' in resource.data) ||
          request.resource.data.accumulatedScribeNotes == resource.data.accumulatedScribeNotes);
    }

    // Host path: may drive phase/status and participant rotations.
    function isSessionHostFieldUpdate() {
      return isSessionHost() &&
        sessionIdentityUnchanged() &&
        sessionOptionalIdentityUnchanged() &&
        isValidTopicUpdate() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'participants', 'participantIds', 'topicSuggestions', 'scribeNotes', 'safetyTimeout',
            'accumulatedScribeNotes', 'status', 'currentPhase', 'currentRound',
            'phaseStartTime', 'fivePersonChoice', 'topic'
          ]) &&
        isValidSessionStatus(request.resource.data.status) &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() <= 50;
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function groupSessionDoc(sessionId) {
      return get(/databases/$(database)/documents/groupSessions/$(sessionId));
    }

    function isMemberOfSession(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId)) &&
        (
          sessionDoc(sessionId).data.hostId == request.auth.uid ||
          (
            'participantIds' in sessionDoc(sessionId).data &&
            request.auth.uid in sessionDoc(sessionId).data.participantIds
          )
        );
    }

    function isMemberOfGroupSession(sessionId) {
      return exists(/databases/$(database)/documents/groupSessions/$(sessionId)) &&
        (
          groupSessionDoc(sessionId).data.hostId == request.auth.uid ||
          (
            'participantIds' in groupSessionDoc(sessionId).data &&
            request.auth.uid in groupSessionDoc(sessionId).data.participantIds
          )
        );
    }

    function isSignalingSessionMember(baseSessionId) {
      return isMemberOfSession(baseSessionId) || isMemberOfGroupSession(baseSessionId);
    }

    function isValidSignalingType(type) {
      return type in ['offer', 'answer', 'ice-candidate', 'join', 'leave'];
    }

    function isValidSignalingCreate() {
      return isAuthenticated() &&
        request.auth.uid == request.resource.data.from &&
        request.resource.data.sessionId is string &&
        request.resource.data.sessionId.size() > 0 &&
        request.resource.data.sessionId.size() <= 160 &&
        request.resource.data.baseSessionId is string &&
        request.resource.data.baseSessionId.size() > 0 &&
        request.resource.data.baseSessionId.size() <= 100 &&
        isValidSignalingType(request.resource.data.type) &&
        isSignalingSessionMember(request.resource.data.baseSessionId) &&
        (
          request.resource.data.type in ['join', 'leave'] ||
          (
            request.resource.data.to is string &&
            request.resource.data.to.size() > 0
          )
        );
    }

    // List queries cannot filter by recipient. Session members may read all
    // signalling for their session; the client ignores messages not meant for it.
    function canReadSignalingMessage() {
      return isAuthenticated() &&
        resource.data.baseSessionId is string &&
        isSignalingSessionMember(resource.data.baseSessionId);
    }

    function isValidGroupSessionCreate(sessionId) {
      return request.resource.data.keys().hasAll([
          'sessionId', 'sessionName', 'duration', 'topic', 'hostId',
          'hostName', 'createdAt', 'participants', 'status',
          'minParticipants', 'maxParticipants', 'topicSuggestions',
          'groupMode', 'groups', 'groupConfiguration'
        ]) &&
        request.resource.data.sessionId == sessionId &&
        request.resource.data.hostId == request.auth.uid &&
        request.resource.data.status == 'waiting' &&
        request.resource.data.participants is list &&
        request.resource.data.groups is list;
    }

    function groupSessionIdentityUnchanged() {
      return sessionIdentityUnchanged() &&
        (!('groupMode' in resource.data) ||
          request.resource.data.groupMode == resource.data.groupMode) &&
        (!('groupConfiguration' in resource.data) ||
          request.resource.data.groupConfiguration == resource.data.groupConfiguration) &&
        (!('hostRole' in resource.data) ||
          request.resource.data.hostRole == resource.data.hostRole);
    }

    function isGroupSessionParticipantFieldUpdate() {
      return isAuthenticated() &&
        groupSessionIdentityUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['participants', 'topicSuggestions', 'groups']) &&
        request.resource.data.participants is list &&
        request.resource.data.groups is list &&
        request.resource.data.status == resource.data.status &&
        (!('currentPhase' in resource.data) ||
          request.resource.data.currentPhase == resource.data.currentPhase) &&
        (!('currentRound' in resource.data) ||
          request.resource.data.currentRound == resource.data.currentRound);
    }

    function isGroupSessionHostFieldUpdate() {
      return isSessionHost() &&
        groupSessionIdentityUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'participants', 'topicSuggestions', 'groups',
            'status', 'currentPhase', 'currentRound', 'phaseStartTime'
          ]) &&
        isValidSessionStatus(request.resource.data.status);
    }

    // ---------------------------------------------------------------
    // Collections
    // ---------------------------------------------------------------

    // Allow anyone to create email signups (for the signup form)
    match /emailSignups/{document} {
      allow create: if
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 320;

      allow read, update, delete: if isSuperadmin();
    }

    // Superadmin collection - allow initial setup and then restrict to superadmins
    match /superadmins/{document} {
      allow read, write: if
        isAuthenticated() &&
        (document == request.auth.uid || isSuperadmin());
    }

    // Test collection (for debugging)
    match /test/{document} {
      allow read, write: if isAuthenticated();
    }

    // Session management rules
    match /sessions/{sessionId} {
      allow create: if isAuthenticated() && isValidSessionCreate(sessionId);

      // Public read required for QR / anonymous join links
      allow read: if true;

      allow update: if isSessionHostFieldUpdate() || isSessionParticipantFieldUpdate();

      // Host may delete; last participant leaving may also delete (leaveSession)
      allow delete: if isSessionHost() ||
        (resource.data.participants is list && resource.data.participants.size() <= 1);
    }

    // Group session management rules
    match /groupSessions/{sessionId} {
      allow create: if isAuthenticated() && isValidGroupSessionCreate(sessionId);

      allow read: if isAuthenticated();

      allow update: if isGroupSessionHostFieldUpdate() ||
        isGroupSessionParticipantFieldUpdate();

      allow delete: if isSessionHost() ||
        (isAuthenticated() &&
          resource.data.participants is list &&
          resource.data.participants.size() <= 1);
    }

    // WebRTC signaling — session members only
    match /signaling/{messageId} {
      allow create: if isValidSignalingCreate();

      allow read: if canReadSignalingMessage();

      allow delete: if
        isAuthenticated() &&
        request.auth.uid == resource.data.from;
    }

    // Public matchmaking queue rooms
    match /matchRooms/{roomId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.roomId == roomId &&
        request.resource.data.mode in ['curious', 'full'] &&
        request.resource.data.audience in ['church', 'open', 'christadelphian'] &&
        request.resource.data.status == 'filling' &&
        request.resource.data.targetSize == 3 &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 1 &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 1 &&
        request.auth.uid in request.resource.data.participantIds;

      allow update: if isAuthenticated() &&
        request.resource.data.roomId == resource.data.roomId &&
        request.resource.data.mode == resource.data.mode &&
        request.resource.data.audience == resource.data.audience &&
        request.resource.data.targetSize == resource.data.targetSize &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() <= 3 &&
        request.resource.data.participantIds is list &&
        (
          // Join / leave / heartbeat while filling
          (
            resource.data.status == 'filling' &&
            request.resource.data.status == 'filling' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantIds', 'lastHeartbeatAt']) &&
            (
              request.auth.uid in resource.data.participantIds ||
              request.auth.uid in request.resource.data.participantIds
            )
          ) ||
          // Form match: fill to 3 and mark matched
          (
            resource.data.status == 'filling' &&
            request.resource.data.status == 'matched' &&
            request.resource.data.matchedSessionId is string &&
            request.resource.data.participants.size() == 3 &&
            request.auth.uid in request.resource.data.participantIds &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'participantIds', 'lastHeartbeatAt', 'status', 'matchedSessionId'])
          ) ||
          // Opportunistic expire
          (
            resource.data.status == 'filling' &&
            request.resource.data.status == 'expired' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
        );

      allow delete: if isAuthenticated() &&
        resource.data.status == 'filling' &&
        request.auth.uid in resource.data.participantIds;
    }

    // Analytics collection for tracking downloads
    match /analytics/{document} {
      allow create: if true;

      allow read, update: if isSuperadmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
